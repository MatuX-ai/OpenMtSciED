// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  email       String   @unique
  password    String
  name        String?
  role        String   @default("user") // user, admin
  imatuUserId String?  @unique // iMato 平台用户 ID
  phone       String?
  avatar      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  learningRecords        LearningRecord[]
  assignments            Assignment[]
  topicDrafts            TopicDraft[]
  creatorProfile         CreatorProfile?
  creditLedgers          CreditLedger[]
  brandTemplates         BrandTemplate[]
  resourceAttributions   ResourceAttribution[]
  conceptTutorialLinks   ConceptTutorialLink[]
  tutorialPackages       TutorialPackage[]
  publishRequests        PublishRequest[]
  publishReviews         PublishRequest[]       @relation("PublishReviewer")
  plagiarismReportsFiled PlagiarismReport[]     @relation("PlagiarismReporter")
  plagiarismReportsAgainst PlagiarismReport[]   @relation("PlagiarismTarget")
  plagiarismReportsResolved PlagiarismReport[]  @relation("PlagiarismAdmin")

  @@index([username])
  @@index([email])
}

// 课程表
model Course {
  id              Int      @id @default(autoincrement())
  courseId        String   @unique // 原始课程ID
  title           String
  subject         String
  gradeLevel      String?
  source          String?
  description     String?
  url             String?
  durationMinutes Int?
  complexity      String?
  metadata        Json? // 存储完整的课程元数据
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  learningRecords LearningRecord[]

  @@index([subject])
  @@index([gradeLevel])
  @@index([source])
}

// 学习记录
model LearningRecord {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    String
  progress    Float     @default(0)
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [courseId], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

// 题库
model Question {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  type        String // multiple_choice, fill_blank, etc.
  difficulty  String   @default("medium") // easy, medium, hard
  subject     String
  grade       String?
  options     Json? // 选择题选项
  answer      String
  explanation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]

  @@index([subject])
  @@index([difficulty])
}

// 作业/练习
model Assignment {
  id          Int       @id @default(autoincrement())
  userId      Int
  questionId  Int
  userAnswer  String?
  isCorrect   Boolean?
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
}

// 爬虫配置
model CrawlerConfig {
  id               String    @id
  name             String
  description      String?
  targetUrl        String?
  type             String    @default("course") // course, question, textbook
  status           String    @default("idle") // idle, running, completed, failed
  progress         Int       @default(0)
  totalItems       Int       @default(0)
  scrapedItems     Int       @default(0)
  lastRun          DateTime?
  errorMessage     String?
  outputFile       String?
  scheduleInterval Int? // hours
  maxItems         Int?    @default(100) // 每次抓取上限
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([type])
}

// 教育平台
model EducationPlatform {
  id           String    @id @default(cuid())
  platformName String    @unique
  source       String?
  targetUrl    String?
  type         String    @default("course")
  status       String    @default("active")
  lastSync     DateTime?
  totalItems   Int       @default(0)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([platformName])
  @@index([status])
}

// ============================================================
// 教程 / 课件 / 硬件项目（Neo4j → PostgreSQL 迁移）
// ============================================================

// 教程表
model Tutorial {
  id              String   @id @default(cuid())
  title           String
  description     String?  @default("")
  gradeLevel      String?  @map("grade_level") @db.VarChar(50)
  subject         String   @db.VarChar(100)
  durationMinutes Int?     @default(60) @map("duration_minutes")
  difficultyLevel String?  @default("beginner") @map("difficulty_level") @db.VarChar(50)
  content         String?  @default("")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subject])
  @@index([gradeLevel])
  @@index([difficultyLevel])
  @@map("tutorial")
}

// 课件表
model Courseware {
  id              String   @id @default(cuid())
  title           String
  description     String?  @default("")
  type            String   @db.VarChar(50) // pdf, video, interactive, etc.
  gradeLevel      String?  @map("grade_level") @db.VarChar(50)
  subject         String   @db.VarChar(100)
  difficultyLevel String?  @default("beginner") @map("difficulty_level") @db.VarChar(50)
  fileUrl         String?  @default("") @map("file_url")
  thumbnailUrl    String?  @default("") @map("thumbnail_url")
  durationMinutes Int?     @default(30) @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subject])
  @@index([type])
  @@index([gradeLevel])
  @@map("courseware")
}

// 硬件项目表
model HardwareProject {
  id                String   @id @default(cuid())
  title             String
  description       String?  @default("")
  difficultyLevel   String   @map("difficulty_level") @db.VarChar(50)
  category          String   @db.VarChar(100) // electronics, robotics, programming, etc.
  subject           String   @db.VarChar(100)
  estimatedTimeHours Float?  @default(2) @map("estimated_time_hours")
  thumbnailUrl      String?  @default("") @map("thumbnail_url")
  hardwareRequired  Json?    @default("[]") @map("hardware_required")
  knowledgePoints   Json?    @default("[]") @map("knowledge_points")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category])
  @@index([difficultyLevel])
  @@index([subject])
  @@map("hardware_project")
}

// ============================================================
// 学习路径闭包表模块（Neo4j → PostgreSQL 迁移）
// ============================================================

// 知识点表
model Concept {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  description   String?
  legacyNeo4jId String?  @unique @map("legacy_neo4j_id") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prerequisites   ConceptDependency[] @relation("Prerequisite")
  dependents      ConceptDependency[] @relation("Dependent")
  ancestorPaths        ConceptPath[]           @relation("Ancestor")
  descendantPaths      ConceptPath[]           @relation("Descendant")
  tutorialLinks        ConceptTutorialLink[]

  @@index([name])
  @@map("concept")
}

// 直接依赖关系表（边）
model ConceptDependency {
  prerequisiteId Int      @map("prerequisite_id")
  dependentId    Int      @map("dependent_id")
  pathType       String   @default("required") @map("path_type") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  prerequisite Concept @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  dependent    Concept @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)

  @@id([prerequisiteId, dependentId, pathType])
  @@index([dependentId, pathType])
  @@index([prerequisiteId, pathType])
  @@map("concept_dependency")
}

// 传递闭包表
model ConceptPath {
  ancestorId   Int    @map("ancestor_id")
  descendantId Int    @map("descendant_id")
  depth        Int
  pathType     String @map("path_type") @db.VarChar(50)

  ancestor   Concept @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Concept @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId, pathType])
  @@index([descendantId, pathType, depth])
  @@index([ancestorId, pathType, depth])
  @@map("concept_path")
}

// 课题工作室草稿
model TopicDraft {
  id                   Int      @id @default(autoincrement())
  userId               Int?     @map("user_id")
  title                String
  subject              String?  @db.VarChar(100)
  gradeLevel           String?  @map("grade_level") @db.VarChar(50)
  goals                String?  @db.Text
  durationHours        Float?   @map("duration_hours")
  maxBudget            Float?   @map("max_budget")
  needsHardware        Boolean  @default(false) @map("needs_hardware")
  outlineJson          Json?    @map("outline_json")
  matchedResourcesJson Json?    @map("matched_resources_json")
  status               String   @default("draft") @db.VarChar(30)
  currentStep          Int      @default(0) @map("current_step")
  localTutorialId      Int?     @map("local_tutorial_id")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  packages TutorialPackage[]

  @@index([userId])
  @@index([status])
  @@map("topic_draft")
}

// 课件来源 attribution（不可删除，仅追加）
model ResourceAttribution {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  resourceType  String   @map("resource_type") @db.VarChar(50)
  resourceId    String   @map("resource_id") @db.VarChar(255)
  resourceTitle String?  @map("resource_title")
  sourceUrl     String   @map("source_url")
  license       String?  @db.VarChar(100)
  author        String?  @db.VarChar(255)
  retrievedAt   DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("resource_attribution")
}

// 创作者档案
model CreatorProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  ccTotal   Int      @default(0) @map("cc_total")
  level     Int      @default(1)
  badges             Json     @default("[]")
  publishFrozenUntil DateTime? @map("publish_frozen_until") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profile")
}

// 创课分流水
model CreditLedger {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(50)
  ccDelta   Int      @map("cc_delta")
  refType   String   @default("") @map("ref_type") @db.VarChar(50)
  refId     String   @default("") @map("ref_id") @db.VarChar(255)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action])
  @@unique([userId, action, refType, refId])
  @@map("credit_ledger")
}

// 品牌模板
model BrandTemplate {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  name          String   @default("默认模板") @db.VarChar(100)
  logoPath      String?  @map("logo_path")
  watermarkText String?  @map("watermark_text")
  footer        String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("brand_template")
}

// 教程 ↔ 知识点挂接
model ConceptTutorialLink {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  conceptId       Int      @map("concept_id")
  localTutorialId Int      @map("local_tutorial_id")
  tutorialTitle   String?  @map("tutorial_title")
  subject         String?  @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, localTutorialId])
  @@index([conceptId])
  @@map("concept_tutorial_link")
}

// 教学包（课题工作室产出）
model TutorialPackage {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  topicDraftId    Int?      @map("topic_draft_id")
  localTutorialId Int?      @map("local_tutorial_id")
  title           String
  subject         String?   @db.VarChar(100)
  gradeLevel      String?   @map("grade_level") @db.VarChar(50)
  packageJson     Json      @map("package_json")
  scope           String    @default("private") @db.VarChar(20)
  status          String    @default("draft") @db.VarChar(30)
  isFeatured      Boolean   @default(false) @map("is_featured")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicDraft       TopicDraft?       @relation(fields: [topicDraftId], references: [id], onDelete: SetNull)
  publishRequests  PublishRequest[]
  plagiarismReports PlagiarismReport[]

  @@index([userId])
  @@index([scope, status])
  @@index([publishedAt])
  @@map("tutorial_package")
}

// 发布审核请求
model PublishRequest {
  id                 Int       @id @default(autoincrement())
  packageId          Int       @map("package_id")
  userId             Int       @map("user_id")
  scope              String    @db.VarChar(20)
  status             String    @default("pending") @db.VarChar(30)
  copyrightConfirmed Boolean   @default(false) @map("copyright_confirmed")
  copyrightType      String?   @map("copyright_type") @db.VarChar(30)
  autoReviewScore    Float?    @map("auto_review_score")
  autoReviewNotes    Json?     @map("auto_review_notes")
  reviewerId         Int?      @map("reviewer_id")
  reviewNote         String?   @map("review_note")
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(3)
  scheduledPayoutAt  DateTime? @map("scheduled_payout_at") @db.Timestamptz(3)
  payoutStatus       String    @default("none") @map("payout_status") @db.VarChar(20)
  payoutPaidAt       DateTime? @map("payout_paid_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  package  TutorialPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?           @relation("PublishReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([scope, status])
  @@index([scheduledPayoutAt, payoutStatus])
  @@map("publish_request")
}

// 抄袭举报
model PlagiarismReport {
  id           Int       @id @default(autoincrement())
  packageId    Int?      @map("package_id")
  reporterId   Int       @map("reporter_id")
  targetUserId Int       @map("target_user_id")
  reason       String    @db.Text
  evidence     String?   @db.Text
  status       String    @default("pending") @db.VarChar(20)
  adminId      Int?      @map("admin_id")
  adminNote    String?   @map("admin_note")
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  package    TutorialPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  reporter   User             @relation("PlagiarismReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User             @relation("PlagiarismTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  admin      User?            @relation("PlagiarismAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetUserId])
  @@map("plagiarism_report")
}
