// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  email       String   @unique
  password    String
  name        String?
  role        String   @default("user") // user, admin
  imatuUserId String?  @unique // iMato 平台用户 ID
  phone       String?
  avatar      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  learningRecords LearningRecord[]
  assignments     Assignment[]

  @@index([username])
  @@index([email])
}

// 课程表
model Course {
  id              Int      @id @default(autoincrement())
  courseId        String   @unique // 原始课程ID
  title           String
  subject         String
  gradeLevel      String?
  source          String?
  description     String?
  url             String?
  durationMinutes Int?
  complexity      String?
  metadata        Json? // 存储完整的课程元数据
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  learningRecords LearningRecord[]

  @@index([subject])
  @@index([gradeLevel])
  @@index([source])
}

// 学习记录
model LearningRecord {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    String
  progress    Float     @default(0)
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [courseId], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

// 题库
model Question {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  type        String // multiple_choice, fill_blank, etc.
  difficulty  String   @default("medium") // easy, medium, hard
  subject     String
  grade       String?
  options     Json? // 选择题选项
  answer      String
  explanation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]

  @@index([subject])
  @@index([difficulty])
}

// 作业/练习
model Assignment {
  id          Int       @id @default(autoincrement())
  userId      Int
  questionId  Int
  userAnswer  String?
  isCorrect   Boolean?
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
}

// 爬虫配置
model CrawlerConfig {
  id               String    @id
  name             String
  description      String?
  targetUrl        String?
  type             String    @default("course") // course, question, textbook
  status           String    @default("idle") // idle, running, completed, failed
  progress         Int       @default(0)
  totalItems       Int       @default(0)
  scrapedItems     Int       @default(0)
  lastRun          DateTime?
  errorMessage     String?
  outputFile       String?
  scheduleInterval Int? // hours
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([type])
}

// 教育平台
model EducationPlatform {
  id           String    @id @default(cuid())
  platformName String    @unique
  source       String?
  targetUrl    String?
  type         String    @default("course")
  status       String    @default("active")
  lastSync     DateTime?
  totalItems   Int       @default(0)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([platformName])
  @@index([status])
}

// ============================================================
// 教程 / 课件 / 硬件项目（Neo4j → PostgreSQL 迁移）
// ============================================================

// 教程表
model Tutorial {
  id              String   @id @default(cuid())
  title           String
  description     String?  @default("")
  gradeLevel      String?  @map("grade_level") @db.VarChar(50)
  subject         String   @db.VarChar(100)
  durationMinutes Int?     @default(60) @map("duration_minutes")
  difficultyLevel String?  @default("beginner") @map("difficulty_level") @db.VarChar(50)
  content         String?  @default("")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subject])
  @@index([gradeLevel])
  @@index([difficultyLevel])
  @@map("tutorial")
}

// 课件表
model Courseware {
  id              String   @id @default(cuid())
  title           String
  description     String?  @default("")
  type            String   @db.VarChar(50) // pdf, video, interactive, etc.
  gradeLevel      String?  @map("grade_level") @db.VarChar(50)
  subject         String   @db.VarChar(100)
  difficultyLevel String?  @default("beginner") @map("difficulty_level") @db.VarChar(50)
  fileUrl         String?  @default("") @map("file_url")
  thumbnailUrl    String?  @default("") @map("thumbnail_url")
  durationMinutes Int?     @default(30) @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subject])
  @@index([type])
  @@index([gradeLevel])
  @@map("courseware")
}

// 硬件项目表
model HardwareProject {
  id                String   @id @default(cuid())
  title             String
  description       String?  @default("")
  difficultyLevel   String   @map("difficulty_level") @db.VarChar(50)
  category          String   @db.VarChar(100) // electronics, robotics, programming, etc.
  subject           String   @db.VarChar(100)
  estimatedTimeHours Float?  @default(2) @map("estimated_time_hours")
  thumbnailUrl      String?  @default("") @map("thumbnail_url")
  hardwareRequired  Json?    @default("[]") @map("hardware_required")
  knowledgePoints   Json?    @default("[]") @map("knowledge_points")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category])
  @@index([difficultyLevel])
  @@index([subject])
  @@map("hardware_project")
}

// ============================================================
// 学习路径闭包表模块（Neo4j → PostgreSQL 迁移）
// ============================================================

// 知识点表
model Concept {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  description   String?
  legacyNeo4jId String?  @unique @map("legacy_neo4j_id") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prerequisites   ConceptDependency[] @relation("Prerequisite")
  dependents      ConceptDependency[] @relation("Dependent")
  ancestorPaths   ConceptPath[]       @relation("Ancestor")
  descendantPaths ConceptPath[]       @relation("Descendant")

  @@index([name])
  @@map("concept")
}

// 直接依赖关系表（边）
model ConceptDependency {
  prerequisiteId Int      @map("prerequisite_id")
  dependentId    Int      @map("dependent_id")
  pathType       String   @default("required") @map("path_type") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  prerequisite Concept @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  dependent    Concept @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)

  @@id([prerequisiteId, dependentId, pathType])
  @@index([dependentId, pathType])
  @@index([prerequisiteId, pathType])
  @@map("concept_dependency")
}

// 传递闭包表
model ConceptPath {
  ancestorId   Int    @map("ancestor_id")
  descendantId Int    @map("descendant_id")
  depth        Int
  pathType     String @map("path_type") @db.VarChar(50)

  ancestor   Concept @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Concept @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId, pathType])
  @@index([descendantId, pathType, depth])
  @@index([ancestorId, pathType, depth])
  @@map("concept_path")
}
